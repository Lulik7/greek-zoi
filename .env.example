# Скопируйте этот файл в .env и заполните значения.
# Файл .env в git не попадает — там лежат секреты.

# --- Общее -------------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Адрес сайта: с него уходят ссылки в письмах и возвраты после оплаты
PUBLIC_URL=https://greek-zoi.com

# Ключ подписи сессий. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Учётная запись администратора. Почта — та, под которой вы входите
# в админку; если не задать, будет admin@zoi.gr.
ADMIN_EMAIL=
# Пароли учётных записей, которые создаются при первом запуске.
# Если не задать, в продакшене сгенерируется случайный и один раз
# напечатается в лог сервера. В коде паролей нет — репозиторий открытый.
ADMIN_PASSWORD=
DEMO_PASSWORD=

# Где хранить базу и загруженные файлы. Нужно, когда в облаке один диск
# монтируется в отдельную точку, например /app/storage. Без переменной —
# папки рядом с кодом сервера.
# STORAGE_DIR=/app/storage

# --- HTTPS -------------------------------------------------------------------
# 1 = переадресовывать http→https и слать HSTS. Нужно, когда сайт стоит за
# прокси (Caddy, Nginx, Railway, Render) — сам сертификат выдаёт прокси.
FORCE_HTTPS=1
# Если сервер должен сам держать TLS (без прокси) — укажите файлы сертификата:
# SSL_KEY_FILE=/etc/ssl/private/greek-zoi.key
# SSL_CERT_FILE=/etc/ssl/certs/greek-zoi.crt

# --- Оплата (Stripe) ---------------------------------------------------------
# Ключи: https://dashboard.stripe.com/apikeys (для тестов начинаются на sk_test_)
STRIPE_SECRET_KEY=
# Секрет вебхука: Developers → Webhooks → endpoint https://ваш-домен/api/stripe/webhook
# события: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# --- Почта -------------------------------------------------------------------
# Подойдёт любой SMTP: Yandex 360, Mail.ru для бизнеса, Gmail с паролем приложения,
# Resend, Postmark, Brevo и т. п.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Школа греческого Зои Павловской <no-reply@greek-zoi.com>

# Требовать подтверждённую почту перед оплатой подписки (1 — да)
REQUIRE_VERIFIED_EMAIL=1
